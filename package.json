{
  "name": "obre",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preview": "npm run build && npx serve out",
    "prebuild": "npm run check",
    "build": "next build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "stylelint": "stylelint \"src/**/*.css\"",
    "fix": "npm run lint && npm run stylelint && npm run format",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint:check -- --max-warnings 0 && npm run stylelint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "hover-tilt": "^1.0.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5"
  }
}
